# Dawa Pharmacy deployment settings. Copy to .env and fill in every value.
# NEVER commit .env (it is git-ignored). If a secret ever leaks, rotate it: see docs/SECURITY.md.
# Generate each password/key with:  openssl rand -base64 32

# --- Database (three separate credentials; least privilege) ---
POSTGRES_SUPERUSER_PASSWORD=
# Owns the schema and runs migrations
DATABASE_OWNER_PASSWORD=
# What the application uses day to day: data access only, no schema changes
DATABASE_APP_PASSWORD=

# --- Application secrets ---
# Signs access tokens (openssl rand -base64 48)
JWT_ACCESS_SECRET=
# Encrypts two-factor authentication secrets in the database (32 bytes, base64)
DATA_ENCRYPTION_KEY=
# Encrypts backup files (32 bytes, base64). Keep a copy OFF the server (e.g. printed in the safe):
# without it, backups cannot be restored.
BACKUP_ENCRYPTION_KEY=

# --- HTTPS ---
# A domain pointing at this server (automatic Let's Encrypt certificate), or the server's
# LAN IP for an in-shop install (Caddy's own certificate; see docs/SECURITY.md).
SITE_ADDRESS=192.168.1.10
# The address staff open, used in password-reset emails
APP_URL=https://192.168.1.10

# --- Backups ---
# Host folder on a DIFFERENT disk, NAS share or synced folder for the second copy of every backup
BACKUP_COPY_HOST_DIR=/mnt/backup-drive/dawa

# --- Optional: malware scanning of uploads (run with: docker compose --profile scan up -d) ---
CLAMAV_HOST=

# --- Optional: email for password resets ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
