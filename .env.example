# Docker deployment settings (copy to .env). Never commit the real file.
DATABASE_PASSWORD=change-me-to-a-long-random-password
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-at-least-32-random-characters
# Public URL staff use (for password-reset links)
APP_URL=http://192.168.1.10:4000
# Plain HTTP on a local network: keep false. Behind HTTPS: set true.
COOKIE_SECURE=false
# Set to 1 when a reverse proxy (Nginx, Caddy) sits in front of the app
TRUST_PROXY=0
HTTP_PORT=4000
# Optional email for password resets
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
