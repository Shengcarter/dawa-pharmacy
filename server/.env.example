# Copy to server/.env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://dawa:CHANGE_ME@localhost:5432/dawa
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ACCESS_TOKEN_TTL_MINUTES=15
APP_URL=http://localhost:5173
# Comma-separated origins allowed to call the API (only needed when the web app is served elsewhere)
CORS_ORIGIN=
# Number of reverse proxies in front of the API (for correct client IPs and rate limits)
TRUST_PROXY=0
STORAGE_DIR=./storage
# Serve the built web app from the API process (single-server deployments)
SERVE_WEB=false
WEB_DIST_DIR=../web/dist
LOG_LEVEL=info
# Optional outgoing email for password resets
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PG_DUMP_PATH=pg_dump
ALERTS_INTERVAL_MINUTES=30
