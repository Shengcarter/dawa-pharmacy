{
  "name": "@dawa/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "seed": "tsx --env-file-if-exists=.env src/db/seed/index.ts",
    "create-admin": "tsx --env-file-if-exists=.env src/db/create-admin.ts",
    "alerts": "tsx --env-file-if-exists=.env src/jobs/run-alerts.ts",
    "backup-decrypt": "tsx --env-file-if-exists=.env src/db/backup-decrypt.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@dawa/shared": "1.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "otplib": "^12.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
